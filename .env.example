# ==============================================================================
# NivaaroFix — Environment Configuration Template
# Copy this file to .env and configure local values before starting servers.
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=nivaarofix_db
PG_USER=postgres
PG_PASSWORD=postgres
PG_SSL=false

# Map & Routing Provider Configuration
# Supported providers:
#   - 'osm_osrm' (Default, zero API key required, Carto Positron basemap & OSRM routing)
#   - 'mapbox'   (Requires MAPBOX_TOKEN / VITE_MAPBOX_TOKEN)
#   - 'google'   (Requires GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY)
MAP_PROVIDER=osm_osrm
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# Client Frontend Map Tokens (Vite)
VITE_MAP_PROVIDER=osm_osrm
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=

# Dispatch Geofence & Business Rules
ARRIVAL_MAX_DISTANCE_METERS=200
DISPATCH_DEFAULT_RADIUS_KM=10
COMMISSION_PERCENT=15

# Authentication & Sessions
JWT_SECRET=replace-with-a-secure-random-secret-key-32-chars-min
SESSION_SECRET=replace-with-a-secure-random-session-secret

# Storage & Uploads
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
