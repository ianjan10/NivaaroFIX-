# ==============================================================================
# NivaaroFix Dashboard Marketplace — Client Environment Variables Template
# Copy this file to .env and configure with your local endpoints.
# ==============================================================================

# Backend REST API Endpoint
VITE_API_URL=http://localhost:5000

# WebLogin Auth Portal URL
VITE_AUTH_PORTAL_URL=http://localhost:5500

# Google Identity Services (OAuth 2.0 Client ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Default Application Language (en, hi, ta, te, kn, mr, bn, gu, ml, pa)
VITE_DEFAULT_LANGUAGE=en
