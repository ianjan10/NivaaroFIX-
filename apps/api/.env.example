# ==============================================================================
# NivaaroFix Backend API — Environment Variables Template
# Copy this file to .env and configure with your local credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=nivaarofix_db

# Client Application Origins (CORS)
CLIENT_DASHBOARD_URL=http://localhost:5173
CLIENT_AUTH_URL=http://localhost:5500

# Authentication & Security Keys
JWT_SECRET=your_super_secret_jwt_key_change_in_production
SESSION_SECRET=your_session_cookie_secret_key

# Google Identity Services (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_optional
