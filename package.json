{
  "name": "nivaarofix-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "NivaaroFix — Monorepo for On-Demand Home Services & Verification Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:auth": "npm --prefix apps/auth run dev",
    "build": "npm run build:all",
    "build:web": "npm --prefix apps/web run build",
    "build:auth": "npm --prefix apps/auth run build",
    "build:all": "npm --prefix apps/web run build && npm --prefix apps/auth run build",
    "test": "node tests/system_health.test.mjs",
    "test:api": "npm --prefix apps/api test",
    "test:web": "npm --prefix apps/web test",
    "test:auth": "npm --prefix apps/auth test",
    "test:e2e": "node tests/arrival_tracking_e2e.test.mjs",
    "test:all": "node tests/system_health.test.mjs && npm --prefix apps/api test && npm --prefix apps/web test && npm --prefix apps/auth test && node tests/arrival_tracking_e2e.test.mjs",
    "db:reset": "node scripts/migrate.js",
    "db:clean": "node scripts/fresh_db_reset.js",
    "bundle:llm": "node scripts/build_full_project_knowledge_bundle.mjs",
    "lint": "eslint . --ext .js,.jsx,.mjs",
    "format": "prettier --write ."
  }
}
